# Database - PostgreSQL (Localhost on VPS or Managed PostgreSQL)
DATABASE_URI=postgresql://postgres:YOUR_STRONG_PASSWORD@localhost:5432/anthony_holidays

# Payload CMS Authentication Secret (Generate with: openssl rand -base64 32)
PAYLOAD_SECRET=your-very-long-and-secure-secret-key-change-this-in-production

# CMS Backend URL
BACKEND_URL=http://localhost:3001
# Production: BACKEND_URL=https://cms.anthonyholidays.com

# Allowed Frontend URL for CORS & CSRF Protection
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://anthonyholidays.com

