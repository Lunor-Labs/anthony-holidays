# Database - PostgreSQL (Localhost on VPS or Managed PostgreSQL)
DATABASE_URI=postgresql://anthony_admin:YOUR_STRONG_PASSWORD@localhost:5432/anthony_holidays

# Payload Secret (Minimum 32 characters, generate with: openssl rand -base64 32)
PAYLOAD_SECRET=your-very-long-and-secure-secret-key-change-this-in-production

# Server Port & Public URL
PORT=3001
PAYLOAD_PUBLIC_SERVER_URL=https://cms.anthonyholidays.com
NEXT_PUBLIC_SERVER_URL=https://cms.anthonyholidays.com

# Frontend Site Origins for CORS and CSRF
NEXT_PUBLIC_SITE_URL=https://anthonyholidays.com
FRONTEND_URL=https://anthonyholidays.com

# Email - Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@anthonyholidays.com
COMPANY_EMAIL=inquiries@anthonyholidays.com
