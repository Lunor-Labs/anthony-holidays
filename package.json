{
  "name": "anthony-holidays-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"cms,web\" -c \"magenta,cyan\" \"npm run dev:cms\" \"npm run dev:web\"",
    "dev:cms": "npm run dev --workspace=apps/cms",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build:web",
    "build:all": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=apps/web",
    "build:cms": "npm run build --workspace=apps/cms",
    "start:web": "npm run start --workspace=apps/web",
    "start:cms": "npm run start --workspace=apps/cms",
    "seed": "npm run seed --workspace=apps/cms",
    "migrate": "npm run migrate --workspace=apps/cms",
    "migrate:status": "npm run migrate:status --workspace=apps/cms",
    "migrate:create": "npm run migrate:create --workspace=apps/cms",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
